<?xml version="1.0" encoding="UTF-8"?>
<!--
  本仓库专用的 Maven settings（构建验证用）。

  为什么需要它：本机 ~/.m2/repository 里已缓存的构件在 _remote.repositories 中记录为 repo id = central，
  而用户级 ~/.m2/settings.xml 的镜像 <id> 是 aliyun，两者不一致会导致 Maven 在离线模式下
  把这些已存在的构件判定为 "absent"。把镜像 id 写成 central 即可让缓存被正确识别。

  用法（配合可写的本地仓库，因为默认仓库 D:\mvnrepo 在本会话沙箱下不可写）：
    mvn -s docs/build/maven-settings.xml "-Dmaven.repo.local=$env:USERPROFILE\.m2\repository" -B compile

  详见 docs/superpowers/specs/2026-09-18-build-verification-notes.md
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>central</id>
      <name>Aliyun Maven Mirror (declared as central)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
